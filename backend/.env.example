# ---- Copy this file to ".env" and fill in the real values ----
# Never commit the real .env file (it is ignored by git on purpose).

# MongoDB connection string (e.g. from MongoDB Atlas)
DATABASE = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Private secret used to sign JWT auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET = "generate_a_long_random_secret_here"

# Optional integrations
#RESEND_API = "your_resend_api"
#OPENAI_API_KEY = "your_openai_api_key"

NODE_ENV = "development"
OPENSSL_CONF = '/dev/null'
PUBLIC_SERVER_FILE = "http://localhost:8888/"
